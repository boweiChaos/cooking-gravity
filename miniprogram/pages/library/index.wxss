/* Remove individual page background */
.container { padding: 40rpx; }
.header-bar { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 40rpx;
}
.page-title { 
  font-size: 40rpx; 
  font-weight: 900; 
  color: #2D2D2D;
}
.add-btn { 
  background: #333333; 
  color: white; 
  font-size: 26rpx; 
  padding: 10rpx 30rpx; 
  border-radius: 40rpx; 
  margin: 0 !important; 
  box-shadow: 4rpx 6rpx 0px #DEDBD3; /* 萌态贴纸阴影 */
}
.category-group {
  margin-bottom: 50rpx;
}
.category-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF9FB;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 3rpx solid #FFC7D6;
}
.category-title::before {
  content: "";
  width: 8rpx;
  height: 32rpx;
  background: #FF8BA7;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.title-text {
  flex: 1;
}
.expand-icon {
  font-size: 28rpx;
  color: #FF8BA7;
  transition: transform 0.3s;
  font-weight: bold;
}
.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.list-item { 
  background: #FFF; 
  padding: 28rpx 30rpx; 
  border-radius: 20rpx; 
  border: 3rpx solid #333;
  box-shadow: 4rpx 5rpx 0px rgba(0,0,0,0.08); /* 手账阴影 */
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-name { font-size: 32rpx; font-weight: 800; color: #2D2D2D;}
.empty { margin-top: 100rpx; text-align: center; color: #888; }
