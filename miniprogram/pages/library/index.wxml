<view class="container">
  <view class="header-bar">
    <text class="page-title">老婆菜谱库</text>
    <button class="add-btn" wx:if="{{isAdmin}}" bindtap="goToAdd">+ 新增菜谱</button>
  </view>

  <view class="category-list" wx:if="{{groupedRecipes.length > 0}}">
    <view class="category-group" wx:for="{{groupedRecipes}}" wx:key="category">
      <view class="category-title" bindtap="toggleCategory" data-index="{{index}}">
        <text class="title-text">{{item.category}}</text>
        <text class="expand-icon">{{item.expanded ? '▼' : '▶'}}</text>
      </view>
      <view class="recipe-list" wx:if="{{item.expanded}}">
        <view class="list-item" wx:for="{{item.recipes}}" wx:for-item="recipe" wx:key="_id" bindtap="goToDetail" data-id="{{recipe._id}}">
          <view class="item-name">{{recipe.name}}</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="empty" wx:else>空空如也，快去添加吧～</view>
</view>
